{
  "name": "swear-jar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "db:test": "supabase test db",
    "dev:mesi-finti": "docker exec -i supabase_db_swear-jar psql -U postgres -d postgres -q -v ON_ERROR_STOP=1 < supabase/dev/mesi-finti.sql",
    "dev:chiudi-mesi": "sh -c 'set -a; . ./.env.local; curl -s -H \"Authorization: Bearer $CRON_SECRET\" ${URL:-http://localhost:3000}/api/cron/close-month; echo'",
    "icons": "node scripts/icons.ts"
  },
  "dependencies": {
    "@serwist/turbopack": "^9.5.13",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "serwist": "^9.5.13"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.5.0"
}
