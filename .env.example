# Copy to .env.local and fill in. Locally: values printed by `supabase status -o env`.

# Public (shipped to the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: never expose to the client
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for /api/cron/close-month (Vercel Cron sends it as a Bearer token).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Notifiche push (Fase 8). Genera le chiavi con: npx web-push generate-vapid-keys
# La pubblica va nel browser, la privata resta sul server.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Facoltativo: contatto per i servizi push (mailto:… oppure l'URL del sito).
VAPID_SUBJECT=
# Secret con cui il database chiama /api/push/flush. Generalo con: openssl rand -hex 32
# Lo stesso valore va nel Vault di Supabase come `push_flush_secret` (vedi README).
PUSH_WEBHOOK_SECRET=
